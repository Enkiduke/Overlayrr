# Copy to .env alongside config.yaml, then fill in the quoted values.
# The script loads this file automatically; shell environment variables win.

PLEX_TOKEN=""
TMDB_API_KEY=""
TVDB_API_KEY=""
FANART_API_KEY=""

# Optional: only for TVDB API keys requiring a subscriber PIN.
TVDB_PIN=""

# Optional: Fanart.tv personal/client key.
FANART_CLIENT_KEY=""

# Optional: password for the web interface (python overlayrr.py config.yaml --serve). At least 8 characters.
OVERLAYRR_WEB_PASSWORD=""
# Optional: where it listens. Defaults: 127.0.0.1 and 8787. Use 0.0.0.0 to allow other machines. --host/--port override these.
OVERLAYRR_WEB_HOST=""
OVERLAYRR_WEB_PORT=""
